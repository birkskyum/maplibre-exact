From c9db5fc89431843fed9f8c511c20d2094aeecfd3 Mon Sep 17 00:00:00 2001
From: Birk Skyum <birk.skyum@pm.me>
Date: Thu, 12 Nov 2026 17:01:54 +0100
Subject: [PATCH 2/2] Trust Android's system certificates without the platform
 verifier's Java part

---
 crates/mln_storage/src/ureq_transport.rs | 34 +++++++++++++++++++++++-
 1 file changed, 33 insertions(+), 1 deletion(-)

diff --git a/crates/mln_storage/src/ureq_transport.rs b/crates/mln_storage/src/ureq_transport.rs
index 5499aad..fc04638 100644
--- a/crates/mln_storage/src/ureq_transport.rs
+++ b/crates/mln_storage/src/ureq_transport.rs
@@ -220,7 +220,7 @@ fn tls_config() -> TlsConfig {
 /// The system's trust store, through rustls-platform-verifier, with ring's
 /// cryptography (ureq's rustls without its baked-in Mozilla roots needs the
 /// provider spelled out).
-#[cfg(not(target_os = "windows"))]
+#[cfg(not(any(target_os = "windows", target_os = "android")))]
 fn tls_config() -> TlsConfig {
     TlsConfig::builder()
         .provider(TlsProvider::Rustls)
@@ -229,6 +229,38 @@ fn tls_config() -> TlsConfig {
         .build()
 }
 
+/// The system's trust store, read from Android's certificate directories,
+/// with ring's cryptography. rustls-platform-verifier needs its Java part
+/// and the app's context first, which a host that loads the library from
+/// native code may not give it; the store it would consult is these files,
+/// without the certificates a user installed.
+#[cfg(target_os = "android")]
+fn tls_config() -> TlsConfig {
+    TlsConfig::builder()
+        .provider(TlsProvider::Rustls)
+        .root_certs(android_roots())
+        .unversioned_rustls_crypto_provider(Arc::new(rustls::crypto::ring::default_provider()))
+        .build()
+}
+
+/// The certificates of the first of Android's certificate directories that
+/// has any: Conscrypt's, which Android 14 and later update, then the system
+/// image's.
+#[cfg(target_os = "android")]
+fn android_roots() -> RootCerts {
+    for dir in ["/apex/com.android.conscrypt/cacerts", "/system/etc/security/cacerts"] {
+        let Ok(entries) = std::fs::read_dir(dir) else { continue };
+        let certs: Vec<_> = entries
+            .filter_map(|entry| std::fs::read(entry.ok()?.path()).ok())
+            .filter_map(|pem| ureq::tls::Certificate::from_pem(&pem).ok())
+            .collect();
+        if !certs.is_empty() {
+            return RootCerts::new_with_certs(&certs);
+        }
+    }
+    RootCerts::PlatformVerifier
+}
+
 impl Client {
     fn new() -> Self {
         Self::with_parts(TcpConnector::default(), DefaultResolver::default())
