// Hello Map: a MapLibre map on a GPU canvas (maplibre-exact), the last event
// it sent, and a button that flies it somewhere.
routes nav
  home "/"

component HelloMap
  state last = ""
  action heard(text: string)
    last = text
  action zurich
    postMessage(`{"command":"flyTo","center":[8.5417,47.3769],"zoom":12,"duration":2500}`, "maplibre")
  view
    main testId="root" navigationKey=`${top(nav).id}` navigationBack="back" width="100%" height="100%"
      for e in stack(nav) key=e.id
        column navigationKey=`${e.id}` position="absolute" inset=0 display="flex" flex-direction="column"
          header display="flex" align-items="center"
            text "Hello Map" role="heading" aria-level=1 flex=1
            button "Zürich" press=zurich testId="zurich"
          canvas surface=maplibre(style="https://tiles.openfreemap.org/styles/liberty", longitude=10.45, latitude=51.16, zoom=4, bearing=0, pitch=0) flex=1 min-height=0 width="100%" touch-action="none" message=heard aria-label="Map" testId="map"
          text last padding=8 testId="last"
