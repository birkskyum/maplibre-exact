From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Birk Skyum <birk.skyum@pm.me>
Date: Thu, 12 Nov 2026 14:52:16 +0100
Subject: [PATCH 2/4] Let Exact's crates take any ureq 3.4 or later

---
 apps/harness/data/Cargo.toml                            | 2 +-
 vendor/ibex/crates/hermes-lean-sys-installer/Cargo.toml | 2 +-
 vendor/ibex/crates/hermes-lean-sys/Cargo.toml           | 4 ++--
 vendor/ibex/crates/ibex2/Cargo.toml                     | 6 +++---
 4 files changed, 7 insertions(+), 7 deletions(-)

diff --git a/apps/harness/data/Cargo.toml b/apps/harness/data/Cargo.toml
index f37e46ba..8cf7b7b8 100644
--- a/apps/harness/data/Cargo.toml
+++ b/apps/harness/data/Cargo.toml
@@ -21,7 +21,7 @@ serde_json = "1.0"
 unicode-width = "0.2"
 png = "=0.18.1"
 rustix = { version = "1.1", features = ["process"] }
-ureq = { version = "=3.4.0", default-features = false, features = ["rustls"] }
+ureq = { version = "3.4", default-features = false, features = ["rustls"] }
 
 # `build.rs` generates the seam's Rust types from `../shapes.contract`
 # with `contract rust` (LLP 1101.002 P9).
diff --git a/vendor/ibex/crates/hermes-lean-sys-installer/Cargo.toml b/vendor/ibex/crates/hermes-lean-sys-installer/Cargo.toml
index 676e7071..ebeb7cea 100644
--- a/vendor/ibex/crates/hermes-lean-sys-installer/Cargo.toml
+++ b/vendor/ibex/crates/hermes-lean-sys-installer/Cargo.toml
@@ -19,4 +19,4 @@ serde_json = "1"
 sha2 = "0.10"
 tar = "0.4"
 tempfile = "3"
-ureq = { version = "=3.4.0", default-features = false, features = ["rustls"] }
+ureq = { version = "3.4", default-features = false, features = ["rustls"] }
diff --git a/vendor/ibex/crates/hermes-lean-sys/Cargo.toml b/vendor/ibex/crates/hermes-lean-sys/Cargo.toml
index 64c6c2b1..3b708f8b 100644
--- a/vendor/ibex/crates/hermes-lean-sys/Cargo.toml
+++ b/vendor/ibex/crates/hermes-lean-sys/Cargo.toml
@@ -40,7 +40,7 @@ serde_json = "1"
 sha2 = "0.10"
 tar = "0.4"
 tempfile = "3"
-ureq = { version = "=3.4.0", default-features = false, features = ["rustls"] }
+ureq = { version = "3.4", default-features = false, features = ["rustls"] }
 
 [dev-dependencies]
 flate2 = "1"
@@ -50,4 +50,4 @@ serde_json = "1"
 sha2 = "0.10"
 tar = "0.4"
 tempfile = "3"
-ureq = { version = "=3.4.0", default-features = false, features = ["rustls"] }
+ureq = { version = "3.4", default-features = false, features = ["rustls"] }
diff --git a/vendor/ibex/crates/ibex2/Cargo.toml b/vendor/ibex/crates/ibex2/Cargo.toml
index e8c1893e..7fed92b7 100644
--- a/vendor/ibex/crates/ibex2/Cargo.toml
+++ b/vendor/ibex/crates/ibex2/Cargo.toml
@@ -30,7 +30,7 @@ ibex2-sqlite = { path = "../ibex2-sqlite" }
 mio = { version = "1", features = ["os-poll", "net"] }
 socket2 = "0.6"
 libc = "0.2"
-ureq = { version = "=3.4.0", default-features = false, features = ["rustls"] }
+ureq = { version = "3.4", default-features = false, features = ["rustls"] }
 rustls = { version = "0.23", default-features = false, features = ["ring", "std", "tls12"] }
 rustls-native-certs = "0.7"
 webpki-roots = "1"
@@ -47,7 +47,7 @@ cc = "1"
 mio = { version = "1", features = ["os-poll", "net"] }
 socket2 = "0.6"
 libc = "0.2"
-ureq = { version = "=3.4.0", default-features = false, features = ["rustls"] }
+ureq = { version = "3.4", default-features = false, features = ["rustls"] }
 # The trust store is the platform's (LLP 0057 §3): the distro's CA bundle
 # through rustls-native-certs; the compiled-in webpki roots only where the
 # machine has none. The same rustls ureq pins, so one copy is linked.
@@ -63,7 +63,7 @@ windows-sys = { version = "0.61.2", features = ["Wdk_Foundation", "Wdk_Storage_F
 [target.'cfg(target_vendor = "apple")'.dependencies]
 mio = { version = "1", features = ["os-poll", "net"], optional = true }
 socket2 = { version = "0.6", optional = true }
-ureq = { version = "=3.4.0", default-features = false, features = ["rustls"], optional = true }
+ureq = { version = "3.4", default-features = false, features = ["rustls"], optional = true }
 rustls = { version = "0.23", default-features = false, features = ["ring", "std", "tls12"], optional = true }
 rustls-native-certs = { version = "0.7", optional = true }
 webpki-roots = { version = "1", optional = true }
