From b610b6f9bb30750aede39fe4cd2b482f9d4af112 Mon Sep 17 00:00:00 2001
From: Birk Skyum <birk.skyum@pm.me>
Date: Thu, 12 Nov 2026 14:55:09 +0100
Subject: [PATCH 3/3] Build ibex2 against ureq 3.5's NextTimeout

---
 vendor/ibex/crates/ibex2/src/transport/rustls_http.rs          | 1 +
 vendor/ibex/crates/ibex2/src/transport/rustls_timeout_tests.rs | 1 +
 2 files changed, 2 insertions(+)

diff --git a/vendor/ibex/crates/ibex2/src/transport/rustls_http.rs b/vendor/ibex/crates/ibex2/src/transport/rustls_http.rs
index 2896deb1..be5c7d2c 100644
--- a/vendor/ibex/crates/ibex2/src/transport/rustls_http.rs
+++ b/vendor/ibex/crates/ibex2/src/transport/rustls_http.rs
@@ -265,6 +265,7 @@ impl ureq::unversioned::resolver::Resolver for Resolver {
         let sync = NextTimeout {
             after: ureq::unversioned::transport::time::Duration::NotHappening,
             reason: timeout.reason,
+            ..NextTimeout::default()
         };
         let (uri, config) = (uri.clone(), config.clone());
         let found = super::lookup::off_thread(&signal, deadline, move || {
diff --git a/vendor/ibex/crates/ibex2/src/transport/rustls_timeout_tests.rs b/vendor/ibex/crates/ibex2/src/transport/rustls_timeout_tests.rs
index 7ba528ce..8ba06c10 100644
--- a/vendor/ibex/crates/ibex2/src/transport/rustls_timeout_tests.rs
+++ b/vendor/ibex/crates/ibex2/src/transport/rustls_timeout_tests.rs
@@ -44,6 +44,7 @@ fn assert_deadlines(context: &Context, exempt: bool) {
             let timeout = NextTimeout {
                 after: WireDuration::from_secs(seconds),
                 reason,
+                ..NextTimeout::default()
             };
             observed.await_input(timeout).unwrap();
             let mut expected = timeout;
