From 444c244ad5778bc6d7f4a76c13fa857ad974191a Mon Sep 17 00:00:00 2001
From: Birk Skyum <birk.skyum@pm.me>
Date: Thu, 12 Nov 2026 13:33:47 +0100
Subject: [PATCH 2/2] Accept ureq 3.4 for Exact's pinned hermes-lean-sys

---
 Cargo.toml | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/Cargo.toml b/Cargo.toml
index fa8e9d4..cbd6435 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -161,7 +161,7 @@ zune-jpeg = { version = "0.5.15" }
 # HTTP for the online file source where the platform has no HTTP stack of
 # its own (the C++ default platform uses curl). mln_storage picks the TLS
 # features per target.
-ureq = { version = "3.5.1", default-features = false }
+ureq = { version = "3.4", default-features = false }
 # ureq's rustls, with ring's cryptography (ureq's own `rustls` feature would
 # also bring webpki-roots).
 rustls = { version = "0.23.46", default-features = false, features = ["ring"] }
